{
  "name": "fp-infographic-agent-kit",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "fp-infographic": "dist/src/cli.js",
    "fp-infographic-mcp": "dist/src/server.js"
  },
  "files": [
    "dist",
    "themes",
    "schemas",
    "templates",
    "examples",
    "docs",
    "adapters",
    "agents",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "install.py"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "package": "npm run build && node dist/src/cli.js tokens --format md --out docs/DESIGN-LANGUAGE.md && node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "description": "Backend-agnostic compiler that turns structured data into editorial infographic frames under a versioned design-language pack."
}