    "fields": {
      "canvas.width": {
        "status": "measured",
        "source": "tpl-1080,tpl-1200,tpl-1400,out-vitalik,out-taxonomy",
        "note": "1920 in every export"
      },
      "canvas.background": {
        "status": "measured",
        "source": "fp-report",
        "note": "published report frames fill #0C0D0F and layer a horizontal edge gradient over it, then add the corner-blob decoration layer. The bare '26 ver template uses a flat #141414 with the blobs only; the report combination is the working standard."
      },
      "canvas.backgroundAlt": {
        "status": "measured",
        "source": "out-taxonomy",
        "note": "#0C0D0F with an overlay gradient"
      },
      "canvas.safe": {
        "status": "measured",
        "source": "fp-contract",
        "note": "Frame guide layout grids: COLUMNS MIN 112, COLUMNS MAX 112, ROWS MAX 164"
      },
      "canvas.heights.steps": {
        "status": "measured",
        "source": "tpl-1080,tpl-1200,tpl-1400"
      },
      "canvas.heights.mode": {
        "status": "measured",
        "source": "out-vitalik,out-taxonomy",
        "note": "produced frames are 1484 and 1511, so height is content-driven rather than snapped"
      },
      "color.neutral": {
        "status": "measured",
        "source": "fp-contract",
        "note": "FP Color System Slate ramp plus the Foundation/BW paint styles read from the live file"
      },
      "color.accent": {
        "status": "measured",
        "source": "fp-contract",
        "note": "'Color System Guide' 28868:13703 — eleven ordered hues: Violet #9A86FF, Indigo #6E8BFF, Blue #4FA3FF, Cyan #2FC9D6, Teal #2FD6A8, Green #5FD96B, Lime #B6D24E, Amber #F2B84C, Orange #F59154, Coral #FF7A6B, Pink #FF6FA5"
      },
      "surface.panel": {
        "status": "measured",
        "source": "fp-contract",
        "note": "'Table' 28868:15151 — container #1A1B1D at 30% with a #51555C 1px stroke, radius 16; header row #3C3E44 at 25%"
      },
      "chrome.contentTop": {
        "status": "measured",
        "source": "fp-contract",
        "note": "title block ends at y=174; content starts below the 174px top band"
      },
      "chrome.bottomBand": {
        "status": "measured",
        "source": "out-vitalik",
        "note": "footer mark starts 66px above the frame bottom"
      },
      "typography": {
        "status": "measured",
        "source": "fp-contract",
        "note": "Text styles: MIN SIZE 16/24.2, MAX SIZE 52/57.2, Title 30/37.4, Regular 28/32, Details 18/26, Text_24pt 24/110%, Text_28pt 28/38. h1 and h2 are taken from the Frame guide title block itself: 50/50 Bold centred and 32/38 SemiBold centred."
      },
      "typography.roles.hero.weight": {
        "status": "declared",
        "source": "fp-contract"
      },
      "typography.family": {
        "status": "declared",
        "source": "fp-contract",
        "note": "not readable from the styles panel; confirm against a live text node"
      },
      "chart": {
        "status": "measured",
        "source": "fp-contract",
        "note": "'Bar Chart' 28868:15047 and 'Line Chart' 28868:15320 — gridlines #232B32 at 80% weight 1.5, axes #777B80 weight 2, bars filled with a vertical accent gradient 0.4 to 0.05 plus a 50% accent stroke, highlighted bars 0.34 to 0.09 with a 100% accent stroke weight 1.5, line series weight 4 with 14px points haloed by a 3px canvas-coloured stroke, area fill at 16%"
      },
      "chrome.topMark": {
        "status": "measured",
        "source": "tpl-svg",
        "note": "Template 1_1_H_1080px.svg: four groups clipped to 24x49 windows at x 895/931/966/1002 with opacity 1/0.7/0.4/0.2. Inside every window the stroke centres are +1.049/7.123/12.635/18.143/23.65 with widths 6/5/4/3/2, so the widest bar is clipped on its left. The strokes run y -8..41 and the frame clips them to a visible height of 41."
      },
      "chrome.titleBlock": {
        "status": "measured",
        "source": "fp-contract",
        "note": "Frame 1991501281 at x=89 w=1743; H1 y=88, H2 y=151"
      },
      "chrome.footer": {
        "status": "measured",
        "source": "fp-contract",
        "note": "Frame 1991501022: 2x66 gradient tick #222324 to #82868A at 0.8, label +26 at 22 Bold #51555C, value +124 at 28 Regular #8D929A"
      },
      "chrome.decoration": {
        "status": "measured",
        "source": "tpl-svg",
        "note": "four 720.23 circles on a 1912.23 layer centred on the frame, each #FFFFFF to #333131 at 0.06; gradient handles read left-to-right, top-to-bottom, bottom-to-top and right-to-left for TL/TR/BL/BR"
      },
      "chrome.watermark": {
        "status": "measured",
        "source": "tpl-svg",
        "note": "Template 1_1_H_1080px.svg: 15 paths spanning x 166..1754, y 461..610 (1588x149). Each glyph carries its own left-to-right #1D1D1D to #2B2B2B ramp at 0.5, not one ramp across the lockup. y=461 is 877 inside the 1912.23 decoration layer, so the wordmark anchors to that layer rather than to the frame."
      },
      "surface.header": {
        "status": "declared",
        "source": "fp-contract"
      },
      "chrome.brandMark": {
        "status": "measured",
        "source": "tpl-svg",
        "note": "15 paths, 257.43x24.45 filled #898989. The bare template centres it 32.55 above the bottom; report frames right-align it in the footer row."
      },
      "color.pairs": {
        "status": "measured",
        "source": "fp-contract",
        "note": "'Contrast pairs for comparison': Blue/Amber, Violet/Lime, Teal/Coral, Cyan/Pink"
      },
      "color.ramps": {
        "status": "measured",
        "source": "fp-contract",
        "note": "'Three ways a scale can work': SEQUENTIAL one hue dim to bright; DIVERGING two hues through a neutral middle"
      },
      "rules.categoricalCeiling": {
        "status": "measured",
        "source": "fp-contract",
        "note": "'The categorical ceiling': about six distinct hues is the limit of what the eye reliably tells apart"
      },
      "surface.node": {
        "status": "measured",
        "source": "fp-contract",
        "note": "'Flowchart Text Boxes' 28868:14636 — base node fill #5E7388 at 12%, stroke #5E7388 at 38% weight 1.5, radius 10, padding 24, gaps 32/24/16/8. A highlighted node uses 12% fill and 100% stroke in the point colour."
      },
      "surface.card": {
        "status": "measured",
        "source": "fp-report",
        "note": "[260908] Ethereum report, frame 33404:10568 — card 844x306 at x=102 filled #1B1B1B to #373737 with a 1px #E1E0D9 stroke; the accent is a separate 15x307 rectangle at x=101 with radius 10/0/0/10, so it reads as a rounded tab behind the card's left edge, not a flush bar. Padding 50/41/25, row gap 36. Eyebrow 18 Bold #898781, title 35 Bold #E6E6E6, body 23 Regular #888888, note 18 Medium tinted from the accent."
      },
      "typography.roles.h1": {
        "status": "measured",
        "source": "fp-report",
        "note": "published report frames set H1 at 60/54 Bold #E6E6E6 centred in the 1743px title block at y=88; the [CLAUDE] guide's 50/50 is an older variant"
      },
      "typography.roles.h2": {
        "status": "measured",
        "source": "fp-report",
        "note": "subtitle 34/35 Medium #BDBDBD centred at y=170, so the gap below H1 is 28"
      },
      "typography.roles.sectionLabel": {
        "status": "measured",
        "source": "fp-report",
        "note": "in-frame section labels are 22/34 Bold #8D929A, set in upper case"
      },
      "canvas.overlay": {
        "status": "measured",
        "source": "fp-report",
        "note": "second frame fill: linear #4F5358 a1 @0, #151618 a0 @0.4925, #4F5358 a1 @1, carried with the source gradientTransform rather than an angle because the real gradient is rotated and skewed"
      },
      "canvas.backgroundVariants": {
        "status": "measured",
        "source": "tpl-1080",
        "note": "'Template 1_1_H:1080px' is a flat #141414 canvas with the corner blobs and no edge gradient; published content frames add #0C0D0F plus the gradient, which is the pack default"
      },
      "surface.table": {
        "status": "measured",
        "source": "monad-renew",
        "note": "Monad Improvement Proposals SVG: surface x112 y223 w1696 h1410 rx16 #1A1B1D@0.3 with a 1px #51555C stroke; header band is a #3C3E44@0.25 fill over the first row; row pitch is a constant 94 with no row rules; header and first column are bold #ECEDEE, other cells regular #D4D5D9; cell cap height 20 gives a 28px body."
      },
      "surface.variants.flat": {
        "status": "measured",
        "source": "monad-renew",
        "note": "Where Monad's Validators Run SVG: KPI cards y272 h270 rx10 opaque #1A1B1D with a 1px #6C707A stroke, 33px inner padding, 24px gutter, widths sized to content (406/459/295/473)."
      },
      "surface.section": {
        "status": "measured",
        "source": "monad-renew",
        "note": "Where Monad's Validators Run SVG: section heading cap 32 (=44px bold #ECEDEE), subtitle cap 18 (=26px #8D929A); heading->subtitle 60, subtitle->content 61, previous content->next heading 71."
      },
      "typography.roles.table": {
        "status": "measured",
        "source": "monad-renew",
        "note": "Cap height 20 at the validated 0.714 cap ratio gives 28px for every table cell; the key column and the header are bold."
      },
      "color.accentSets.report": {
        "status": "measured",
        "source": "monad-renew",
        "note": "The three renewed Monad report SVGs use exactly four chromatic fills - #4F86C6 blue (dominant), #5BA86B green, #C97A5B coral, #D2A24E amber - plus #8D929A for the ungrouped tail. The eleven-hue guide set stays available as accentSets.guide."
      },
      "color.tail": {
        "status": "measured",
        "source": "monad-renew",
        "note": "#8D929A carries every 'Other' segment and every unhighlighted series in the renewed reports; it is a neutral, never an accent."
      },
      "chart.editorialBar": {
        "status": "measured",
        "source": "monad-renew",
        "note": "Where Monad's Validators Run SVG: rows pitch 62 with 34-tall rx3 bars, plot left 412 with labels right-aligned to 390 (22 gutter), value text 30px past the bar end; label and count are #ECEDEE, the share is #8D929A. Stacked segments sit 2px apart."
      },
      "surface.variants.flat.roles": {
        "status": "measured",
        "source": "monad-renew",
        "note": "Where Monad's Validators Run SVG: card top padding 38; eyebrow cap 19 (=26px #8D929A, sentence case), value digits cap 48 (=68px bold #ECEDEE), note cap 19 over two lines pitched 34 (=26px #8D929A)."
      },
      "typography.metrics": {
        "status": "measured",
        "source": "figma-live",
        "note": "Calibrated against the live substituted family (Apple SD Gothic Neo) by creating text nodes in the FP file and comparing widths: '37.6%' 26px live 68 vs 61.4 estimated, '28.9%' live 71, '74' 28px live 30, 'Western Europe' 28px live 190, '197' 68px live 99. digit 0.56 and punct 0.34 were optimistic for digit-and-symbol runs, so a percentage set one line too long in Figma while the SVG fitted. digit 0.60 and punct 0.52 make every probe pessimistic, which is the only safe direction for an offline model."
      },
      "chart.gridline": {
        "status": "declared",
        "source": "fp-contract",
        "note": "The published charts draw no gridline at all; when one is needed it is the pack's neutral.800, not a blue-tinted grey invented for the renderer."
      },
      "color.base": {
        "status": "measured",
        "source": "fp-contract",
        "note": "'Flowchart Text Boxes' 28868:14636 - the base hue every flow node sits on, 12% fill and 38% stroke. Promoted from a loose hex in surface.node to a named token so the pack has no unnamed colour."
      }
    }
  },
